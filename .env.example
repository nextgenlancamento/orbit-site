DATABASE_URL=
# Exemplo PostgreSQL: pgsql:host=localhost;port=5432;dbname=nome_do_banco
DATABASE_USER=
DATABASE_PASSWORD=

# Defina um valor real e transparente. Não use valores fictícios.
CAMPAIGN_FEE=21.40
PIX_KEY=
MERCHANT_NAME=
MERCHANT_CITY=
