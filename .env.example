# Copie para .env e preencha no servidor. Nunca publique o .env.
PIX_BASE_URL=
PIX_CLIENT_KEY=
PIX_CLIENT_SECRET=
PIX_AUTH_PATH=/oauth/token
PIX_CHARGE_PATH=/v1/pix/charges
PIX_STATUS_PATH=/v1/pix/charges/{id}
PIX_WEBHOOK_SECRET=
